+    // Campfire (wasm patch 0111): exportData in pages (storage::ExportDataPageToJson), for a wallet
+    // whose whole export does not fit in the engine's fixed heap. cb(json, next) on the main thread:
+    // next is where the following page starts, -1 after the last; cb(null, -1) on failure.
+    void ExportDataPage(uint32_t firstTx, uint32_t maxBytes, val cb)
+    {
+        AssertMainThread();
+        if (!m_Client || !m_Client->isRunning())
+        {
+            cb(val::null(), -1);
+            return;
+        }
+        const uint32_t id = ++m_DataRequests;
+        m_DataCallbacks.emplace(id, std::move(cb));
+        std::weak_ptr<int> alive = m_Alive;
+        m_Client->getAsync()->makeIWTCall([client = m_Client.get(), firstTx, maxBytes]() -> boost::any
+        {
+            std::pair<std::string, int64_t> page{ std::string(), -1 };
+            try
+            {
+                auto db = client->GetWalletDB();
+                if (db)
+                    page.first = storage::ExportDataPageToJson(*db, firstTx, maxBytes, page.second);
+            }
+            catch (const std::exception&)
+            {
+                page.first.clear();
+            }
+            return boost::any(std::move(page));
+        },
+        [this, alive, id](const boost::any& res)
+        {
+            if (alive.expired())
+                return;
+            auto it = m_DataCallbacks.find(id);
+            if (it == m_DataCallbacks.end())
+                return;
+            val cb = std::move(it->second);
+            m_DataCallbacks.erase(it);
+            auto* page = boost::any_cast<std::pair<std::string, int64_t>>(&const_cast<boost::any&>(res));
+            if (page && !page->first.empty())
+                cb(page->first, static_cast<double>(page->second));
+            else
+                cb(val::null(), -1);
+        });
+    }
+
