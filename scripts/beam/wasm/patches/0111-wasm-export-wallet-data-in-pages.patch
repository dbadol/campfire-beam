+        // Campfire (wasm patch 0111): the WebAssembly wallet runs in a fixed 100 MB heap, and
+        // ExportDataToJson holds the whole file as one JSON tree and one string: a wallet with ~10 MB of
+        // wallet data runs out of memory (measured). The same transactions, the same skipping rules and
+        // the same fields as ExportTransactionsToJson, a page at a time; the parameters are grouped by
+        // pointer, not copied.
+        string ExportDataPageToJson(const IWalletDB& db, uint32_t firstTx, uint32_t maxBytes, int64_t& nextTx)
+        {
+            nextTx = -1;
+            const auto all = db.getAllTxParameters();
+            map<TxID, map<SubTxID, map<TxParameterID, const ByteBuffer*>>> byTx;
+            for (const auto& p : all)
+            {
+                byTx[p.m_txID][(SubTxID)p.m_subTxID].emplace((TxParameterID)p.m_paramID, &p.m_value);
+            }
 
+            vector<TxID> exportable;
+            exportable.reserve(byTx.size());
+            for (const auto& tx : byTx)
+            {
+                auto it = tx.second.find(kDefaultSubTxID);
+                if (it == tx.second.end())
+                {
+                    continue; // no mandatory parameters: ExportTransactionsToJson skips it too
+                }
+                const auto& params = it->second;
+                if (params.size() == 1 && params.begin()->first == TxParameterID::TransactionType) // deleted
+                {
+                    continue;
+                }
+                if (params.find(TxParameterID::TransactionType) == params.end() || params.find(TxParameterID::CreateTime) == params.end())
+                {
+                    continue;
+                }
+                exportable.push_back(tx.first);
+            }
+
+            json txParams = json::array();
+            size_t bytes = 0;
+            size_t i = firstTx;
+            for (; i < exportable.size(); ++i)
+            {
+                json one = json::array();
+                for (const auto& subTx : byTx[exportable[i]])
+                {
+                    for (const auto& p : subTx.second)
+                    {
+                        one.push_back(
+                            json
+                            {
+                                {Fields::TransactionId, exportable[i]},
+                                {Fields::SubTransactionId, subTx.first},
+                                {Fields::ParameterId, p.first},
+                                {Fields::Value, *p.second}
+                            }
+                        );
+                    }
+                }
+                const size_t size = one.dump().size();
+                if (i > firstTx && bytes + size > maxBytes)
+                {
+                    break;
+                }
+                bytes += size;
+                for (auto& v : one)
+                {
+                    txParams.push_back(std::move(v));
+                }
+            }
+            if (i < exportable.size())
+            {
+                nextTx = static_cast<int64_t>(i);
+            }
+
+            json res = json::object();
+            if (firstTx == 0)
+            {
+                res[Fields::OwnAddresses] = ExportAddressesToJson(db, true);
+                res[Fields::Contacts] = ExportAddressesToJson(db, false);
+            }
+            res[Fields::TransactionParameters] = std::move(txParams);
+            return res.dump();
+        }
+
